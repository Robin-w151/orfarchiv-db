{
  "name": "db",
  "version": "1.8.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#common/*": "./src/shared/common/src/*.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "vite build",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "dotenv-flow": "4.1.0",
    "effect": "4.0.3",
    "mongodb": "7.7.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.19.2",
    "bun": "1.4.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-recommended": "4.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "semantic-release-gha-output": "1.1.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">=8.0.0",
    "glob": ">=10.5.0",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.11.0"
}
